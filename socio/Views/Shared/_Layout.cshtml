<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Socio</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />

    @RenderSection("Styles", required: false)

    <style>
        body {
            background-color: #fff;
            margin: 0;
            display: flex;
            flex-direction: row;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
        }

        .sidebar {
            width: 250px;
            background-color: #fff;
            border-right: 1px solid #dbdbdb;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 20px 15px;
            position: fixed;
            height: 100vh;
        }

        .sidebar img.logo {
            width: 120px;
            align-self: center;
            margin: 20px 0;
        }

        .sidebar .nav-links {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .sidebar .nav-links a {
            text-decoration: none;
            color: #262626;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 17px;
            padding: 8px 10px;
            border-radius: 8px;
            transition: background-color 0.2s, padding-left 0.2s;
        }

        .sidebar .nav-links a:hover {
            background-color: #f1f1f1;
            padding-left: 15px;
        }

        .main-content {
            margin-left: 250px;
            flex: 1;
            padding: 20px 10px;
        }

        .mobile-topbar,
        .bottom-navbar {
            display: none;
        }

        @@media(max-width: 768px) {
            body {
                flex-direction: column;
            }

            .sidebar {
                display: none;
            }

            .mobile-topbar,
            .bottom-navbar {
                display: flex;
            }

            .main-content {
                margin-left: 0;
                padding: 40px 20px;
            }

            .bottom-navbar {
                position: fixed;
                bottom: 0;
                left: 0;
                width: 100%;
                background-color: #fff;
                border-top: 1px solid #dbdbdb;
                justify-content: space-around;
                align-items: center;
                padding: 10px 0;
                z-index: 1000;
            }

            .bottom-navbar a {
                color: #262626;
                font-size: 24px;
            }

            .bottom-navbar a:hover {
                color: #000;
            }

            .bottom-navbar a,
            .mobile-topbar button {
                text-decoration: none;
                color: #262626;
            }

            .bottom-navbar a:focus,
            .bottom-navbar a:hover,
            .mobile-topbar button:focus,
            .mobile-topbar button:hover {
                text-decoration: none;
                outline: none;
                color: #262626;
            }
        }
    </style>

    <style>
        #toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
        }

        .toast-message {
            background: white;
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 12px 16px;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-width: 280px;
            max-width: 360px;
            animation: slideIn 0.3s ease;
            font-family: 'Segoe UI', system-ui, sans-serif;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        }

        .toast-message span:first-child {
            color: #000;
            padding-right: 12px;
            font-size: 14px;
            line-height: 1.4;
        }

        .toast-message span:first-child a {
            color: #000;
            font-weight: 600;
            text-decoration: underline;
        }

        .toast-message span:first-child em {
            color: #000;
            font-style: italic;
            font-weight: 500;
            background: #f5f5f5;
            padding: 1px 4px;
            border-radius: 2px;
        }

        .toast-message .close-btn {
            cursor: pointer;
            color: #333;
            font-size: 20px;
            font-weight: 300;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            background: none;
            border: none;
            padding: 0;
        }

        .toast-message .close-btn:hover {
            color: #000;
            background: #f5f5f5;
            border-radius: 50%;
        }

        @@keyframes slideIn {
            0% {
                opacity: 0;
                transform: translateX(100%);
            }
            100% {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .toast-message.toast-exit {
            animation: slideOut 0.3s ease forwards;
        }

        @@keyframes slideOut {
            0% {
                opacity: 1;
                transform: translateX(0);
            }
            100% {
                opacity: 0;
                transform: translateX(100%);
            }
        }
    </style>
</head>

<body>

    <!-- Desktop Sidebar -->
    <div class="sidebar d-none d-md-flex flex-column">
        <div>
            <a href="@Url.Action("Index", "UserHome")">
                <img src="~/images/landing-logo-img.png" alt="Logo" class="logo" />
            </a>
            <div class="nav-links">
                <a asp-controller="UserHome" asp-action="Index"><i class="bi bi-house-fill"></i> Home</a>
                <a asp-controller="Post" asp-action="Create"><i class="bi bi-plus-circle"></i> Create</a>
                <a asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle"></i> Profile</a>
                <a asp-controller="Search" asp-action="Index"><i class="bi bi-search"></i> Search</a>
            </div>
        </div>

        <div class="nav-links mt-3">
            <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-link text-dark p-0">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </button>
            </form>
        </div>
    </div>

    <!-- Mobile Topbar -->
    <div class="mobile-topbar d-flex d-md-none justify-content-between align-items-center p-2 border-bottom">
        <a href="@Url.Action("Index", "UserHome")">
            <img src="~/images/landing-logo-img.png" alt="Logo" height="35" />
        </a>

        <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-link text-dark p-0">
                <i class="bi bi-box-arrow-right"></i> Logout
            </button>
        </form>
    </div>

    <div id="toast-container"></div>

    <!-- Main Content -->
    <div class="main-content">
        @RenderBody()
    </div>

    <!-- Mobile Bottom Navbar -->
    <div class="bottom-navbar d-flex d-md-none justify-content-around align-items-center border-top">
        <a asp-controller="UserHome" asp-action="Index"><i class="bi bi-house-fill"></i></a>
        <a asp-controller="Post" asp-action="Create"><i class="bi bi-plus-circle"></i></a>
        <a asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle"></i></a>
        <a asp-controller="Search" asp-action="Index"><i class="bi bi-search"></i></a>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SignalR (CORRECT VERSION) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>

    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        connection.start()
            .then(() => console.log("SignalR connected"))
            .catch(err => console.error(err.toString()));

        function showToast(htmlMessage) {
            const toast = $(`
                <div class="toast-message">
                    <span>${htmlMessage}</span>
                    <button class="close-btn">&times;</button>
                </div>
            `);

            toast.find('.close-btn').click(function () {
                $(this).closest('.toast-message').addClass('toast-exit');
                setTimeout(() => toast.remove(), 300);
            });

            $('#toast-container').append(toast);

            if ($('#toast-container .toast-message').length > 3) {
                $('#toast-container .toast-message').first().addClass('toast-exit');
                setTimeout(() => $('#toast-container .toast-message').first().remove(), 300);
            }
        }

        connection.on("ReceiveNotification", function (message) {
            showToast(message);
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
