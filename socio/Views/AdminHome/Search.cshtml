@section Styles {
    <style>
        .search-heading {
            text-align: center;
            font-size: 30px;
            font-weight: 600;
            font-family: 'Roboto', sans-serif;
            margin-top: 20px;
            color: #333;
        }

        .search-bar-wrapper {
            display: flex;
            justify-content: center;
            margin: 20px 0;
        }

        .search-bar-wrapper input[type="text"] {
            width: 400px;
            max-width: 90%;
            padding: 8px 12px;
            font-size: 16px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }

        .search-bar-wrapper button {
            padding: 8px 12px;
            margin-left: 5px;
            font-size: 16px;
            border-radius: 5px;
            border: none;
            background-color: black;
            color: white;
            cursor: pointer;
        }

        .users-container-wrapper {
            display: flex;
            justify-content: center;
            margin-top: 20px;
            margin-bottom: 30px;
        }

        .users-container {
            max-width: 600px;
            width: 100%;
            padding: 20px;
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .user-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            border: 1px solid #ddd;
            border-radius: 8px;
            background: #fff;
            padding: 12px 15px;
            transition: background-color 0.2s ease;
            flex-wrap: nowrap;
        }

        .user-card:hover {
            background-color: #f8f8f8;
        }

        .user-info {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-info img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #ccc;
        }

        .user-info .text {
            display: flex;
            flex-direction: column;
        }

        .user-info h4 {
            font-size: 16px;
            font-weight: 600;
            margin: 0;
        }

        .user-info p {
            font-size: 13px;
            color: #666;
            margin: 2px 0 0;
        }

        .user-actions {
            display: flex;
            gap: 5px;
            flex-shrink: 0;
        }

        .user-actions a,
        .user-actions form {
            display: inline-block;
        }

        .user-actions button {
            padding: 5px 10px;
            font-size: 13px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: 0.2s;
        }

        .btn-view,
        .btn-comments {
            background-color: black;
            color: white;
        }

        .btn-delete {
            background-color: #c82333;
            color: white;
        }

        @@media (max-width: 768px) {
            .users-container {
                max-width: 90%;
            }

            .user-card {
                flex-wrap: wrap;
                justify-content: space-between;
            }

            .user-actions {
                margin-top: 8px;
            }

            .search-bar-wrapper input[type="text"] {
                width: 70%;
            }
        }
    </style>
}
@model List<SocioApp.Models.ProfileViewModel>
@using Microsoft.AspNetCore.Identity
@using SocioApp.Models
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var currentUserId = currentUser?.Id;
}

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Search Users";
    var searchQuery = ViewData["SearchQuery"] as string ?? "";
}

<div class="search-bar-wrapper">
    <form method="get" asp-action="Search" asp-controller="AdminHome">
        <input type="text" name="query" placeholder="Search by username..." value="@searchQuery" />
        <button type="submit">Search</button>
    </form>
</div>

<div class="users-container-wrapper">
    <div class="users-container">
        @if (!Model.Any())
        {
            <p style="text-align:center;">No users found.</p>
        }
        else
        {
            foreach (var user in Model)
            {
                <div class="user-card">
                    <div class="user-info">
                        <img src="@Url.Content(string.IsNullOrWhiteSpace(user.ProfileImage) 
                            ? "/images/defaultprofile.png" 
                            : user.ProfileImage)"
                             alt="@user.Username" />

                        @* <a asp-controller="Profile" asp-action="ViewProfile" asp-route-id="@user.Id"> *@
                            <div class="text">
                                <h4>@user.Username</h4>
                                <p>@user.PostsCount posts</p>
                            </div>
                        @* </a> *@
                    </div>

                    <div class="user-actions">
                        <a asp-controller="AdminHome" asp-action="Profile" asp-route-id="@user.Id">
                            <button class="btn-view">View Profile</button>
                        </a>

                        <a asp-controller="AdminHome" asp-action="Comments" asp-route-id="@user.Id">
                            <button class="btn-comments">View Comments</button>
                        </a>
 
                        <form class="ban-form">
                            @Html.AntiForgeryToken()
                            @if(currentUserId != user.Id){
                            <button type="button"
                                    class="btn-delete js-ban-toggle"
                                    data-user-id="@user.Id"
                                    data-is-banned="@user.IsBanned"
                                    data-url="@Url.Action("BanUnbanUser", "AdminHome")">
                                @(user.IsBanned ? "Unban User" : "Ban User")
                            </button>
                            }
                        </form>
                    </div>
                </div>
            }
        }
    </div>
</div>
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

<script>
$(document).on("click", ".js-ban-toggle", function () {

    const button = $(this);
    const userId = button.data("user-id");
    const url = button.data("url");
    const token = button.closest("form")
                        .find('input[name="__RequestVerificationToken"]')
                        .val();

    button.prop("disabled", true);

    $.ajax({
        url: url,
        type: "POST",
        data: {
            id: userId,
            __RequestVerificationToken: token
        },
        success: function (response) {
            if (response.success) {
                button.text(response.isBanned ? "Unban User" : "Ban User");
                button.data("is-banned", response.isBanned);
            } else {
                alert(response.message || "Operation failed");
            }
        },
        error: function (xhr) {
            console.error(xhr.responseText);
            alert("An unexpected error occurred.");
        },
        complete: function () {
            button.prop("disabled", false);
        }
    });
});
</script>
